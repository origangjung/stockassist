{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "sum(rate(stockpilot_http_requests_total[5m]))", "legendFormat": "requests/s", "refId": "A" }
      ],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(stockpilot_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }
      ],
      "title": "API p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "sum(rate(stockpilot_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx/s", "refId": "A" }
      ],
      "title": "Server errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }] }, "overrides": [] },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "stockpilot_dependency_ready", "legendFormat": "{{dependency}}", "refId": "A" }
      ],
      "title": "Required dependencies",
      "type": "stat"
    }
  ],
  "refresh": "15s",
